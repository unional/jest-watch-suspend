{
	"name": "jest-watch-suspend",
	"version": "2.0.0",
	"description": "Suspend watch mode",
	"keywords": [
		"jest",
		"jest-watch-plugins",
		"testing",
		"tooling"
	],
	"homepage": "https://github.com/repobuddy/jest-watch-suspend",
	"bugs": {
		"url": "https://github.com/repobuddy/jest-watch-suspend/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/jest-watch-suspend.git"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com"
	},
	"type": "module",
	"files": [
		"lib"
	],
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"main": "lib/index.js",
	"typings": "lib/index.d.ts",
	"scripts": {
		"build": "tsdown",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "rimraf lib coverage .turbo",
		"coverage": "jest --coverage",
		"cs": "changeset",
		"depcheck": "depcheck",
		"format": "biome format . --write",
		"lint": "biome lint .",
		"nuke": "pnpm clean && rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "jest",
		"typecheck": "tsc",
		"verify": "run-p lint verify:pkg",
		"verify:pkg": "turbo run build coverage depcheck typecheck",
		"version": "changeset version",
		"watch": "jest --watch"
	},
	"dependencies": {
		"chalk": "^4.1.2",
		"unpartial": "^1.0.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.2.0",
		"@commitlint/config-conventional": "^21.2.0",
		"@repobuddy/biome": "^2.3.0",
		"@swc/jest": "^0.2.39",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.0.0",
		"depcheck": "^1.4.7",
		"husky": "^9.1.7",
		"jest": "30.5.2",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.0",
		"tsdown": "^0.23.0",
		"turbo": "^2.10.0",
		"typescript": "^7.0.0"
	},
	"peerDependencies": {
		"jest": ">=28"
	},
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
